# Copy to .env.local and fill in. Never commit the copy.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only: the API routes, the guideline ingestion and the data scripts
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI: the advisor, the clinical engine, the alerts and the guideline embeddings
OPENAI_API_KEY=sk-your-openai-key

# Deepgram: live transcription in a consultation (nova-3-medical).
# Server only: /api/deepgram/token trades it for a 30-second token for each
# socket the browser opens. The key needs Member permissions or higher.
DEEPGRAM_API_KEY=your-deepgram-key

# Optional. Without Supabase, or when it does not answer in 4 s, the app runs
# on the synthetic records bundled with it (src/data/demo).

# Server only, optional. Vercel sends CRON_SECRET with its daily call to
# /api/keep-alive, which reads one row so a free Supabase project does not pause.
CRON_SECRET=

# Scripts only: where scripts/batch_clinical_engine_processing.ts finds the app
API_BASE_URL=http://localhost:3000

# Python prototype only (src/clinical_engine_prototype), with its defaults
# MAX_PROCESSING_TIME_MINUTES=5
# MAX_SOURCES_PER_STEP=10
# MAX_PARALLEL_PROCESSES=5
# ENABLE_SOURCE_VERIFICATION=true
